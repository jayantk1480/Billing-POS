# Settings for the production server. Copy to .env in this folder and fill in. Never commit .env.
# Lines marked GENERATE need a secret of your own: run the command shown and paste the result.

# ── Addresses ──
# All five must be under the same domain (for example all ending in yourbrand.in): signing in depends on it.
# Each needs a DNS "A" record pointing at this server before the first start.
APP_DOMAIN=app.example.com
POS_DOMAIN=pos.example.com
KDS_DOMAIN=kds.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# Where the certificate authority writes if a certificate is about to expire and could not be renewed.
ACME_EMAIL=you@example.com

# Optional: the only addresses allowed to open the platform admin, space separated and in quotes,
# for example ADMIN_ALLOWED_IPS="203.0.113.7 198.51.100.0/24".
# Leave empty to allow any address. Recommended once you know your office address: the admin app has no two-step sign-in yet.
ADMIN_ALLOWED_IPS=

# ── Names shown to people ──
APP_NAME="Rasoi POS"
# Shown to restaurants on their trial and renewal notices. Optional.
SUPPORT_EMAIL=

# ── Secrets ──
# GENERATE: openssl rand -hex 24
POSTGRES_PASSWORD=
# GENERATE: openssl rand -hex 48
JWT_ACCESS_SECRET=

# ── Email (confirmation links, password links) ──
# From any provider that gives you SMTP details: Amazon SES, Brevo, Zoho Mail, your own mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must be an address your provider lets you send from.
SMTP_FROM="Rasoi POS <no-reply@example.com>"

# ── Registration ──
# "false" stops restaurants registering themselves; you then add them from the platform admin.
SIGNUP_ENABLED=true
TRIAL_DAYS=14

# ── Your own sign-in to the platform admin ──
# Used only by `docker compose run --rm platform-admin`. At least 12 characters.
# GENERATE: openssl rand -base64 18
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME="Platform admin"

# ── Backups (see backup.sh) ──
# Where backups are kept on this server, and for how many days.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Optional but strongly recommended: an rclone destination off this server, for example "b2:my-bucket/pos".
BACKUP_REMOTE=
