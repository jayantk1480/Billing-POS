// Restaurant POS data model.
// Conventions: UUID primary keys (client-generatable for offline), money in integer paise,
// tax rates in basis points (500 = 5%), every tenant table carries restaurant_id.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum GstRegistration {
  REGULAR
  COMPOSITION
  UNREGISTERED
}

enum RoundOffMode {
  NONE
  NEAREST_RUPEE
}

enum OrderNumberReset {
  DAILY
  FINANCIAL_YEAR
  NEVER
}

enum OrderRenumberMode {
  AUTO
  MANUAL
  OFF
}

enum TaxComponentType {
  CGST
  SGST
  IGST
  CESS
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum TableStatus {
  FREE
  OCCUPIED
  BILL_PRINTED
  BLOCKED
}

enum TableShape {
  SQUARE
  ROUND
  RECTANGLE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  OPEN
  HELD
  BILLED
  SETTLED
  CANCELLED
  MERGED
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum KotType {
  NEW
  CANCEL
}

enum KotStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum SeriesType {
  INVOICE
  CREDIT_NOTE
}

enum InvoiceDocType {
  TAX_INVOICE
  BILL_OF_SUPPLY
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RegisterStatus {
  OPEN
  CLOSED
}

enum CashTransactionType {
  OPENING
  CASH_IN
  CASH_OUT
  SALE
  REFUND
}

enum PrinterRole {
  RECEIPT
  KOT
}

enum PrinterConnection {
  NETWORK
  USB
  BLUETOOTH
  BROWSER
}

enum PaperWidth {
  MM58
  MM80
}

enum PrintJobType {
  RECEIPT
  KOT
  CREDIT_NOTE
  REGISTER_REPORT
  TEST
}

enum PrintJobStatus {
  QUEUED
  PRINTING
  DONE
  FAILED
}

enum SyncOperationStatus {
  APPLIED
  REJECTED
}

// ───────────────────── Tenant and access ─────────────────────

model Restaurant {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  legalName    String?  @map("legal_name")
  gstin        String?
  fssaiNumber  String?  @map("fssai_number")
  phone        String?
  email        String?
  addressLine1 String?  @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String?
  stateCode    String   @map("state_code") @db.VarChar(2) // GST state code, e.g. "27"
  stateName    String   @map("state_name")
  pincode      String?
  logoUrl      String?  @map("logo_url")
  isActive     Boolean  @default(true) @map("is_active") // false = suspended by the platform: nobody can sign in
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Subscription. With neither date set the restaurant has no time limit (a self-hosted or pre-SaaS restaurant).
  trialEndsAt           DateTime? @map("trial_ends_at")
  paidUntil             DateTime? @map("paid_until") @db.Date // the last day that is paid for
  suspendedAt           DateTime? @map("suspended_at")
  suspendReason         String?   @map("suspend_reason")
  createdVia            String    @default("SEED") @map("created_via") @db.VarChar(10) // SEED, SIGNUP or PLATFORM
  onboardingDismissedAt DateTime? @map("onboarding_dismissed_at")

  settings        RestaurantSettings?
  users           User[]
  roles           Role[]
  terminals       Terminal[]
  posDevices      PosDevice[]
  numberSeries    NumberSeries[]
  taxGroups       TaxGroup[]
  kitchenStations KitchenStation[]
  categories      Category[]
  products        Product[]
  modifierGroups  ModifierGroup[]
  areas           Area[]
  tables          DiningTable[]
  customers       Customer[]
  orders          Order[]
  discounts       Discount[]
  kots            Kot[]
  invoices        Invoice[]
  payments        Payment[]
  refunds         Refund[]
  registers       CashRegisterSession[]
  printers        Printer[]
  printTemplates  PrintTemplate[]
  printJobs       PrintJob[]
  printBridges    PrintBridge[]
  reconciliations PaymentReconciliation[]
  auditLogs       AuditLog[]
  syncOperations  SyncOperation[]
  idempotencyKeys IdempotencyRecord[]
  reportShares    ReportShare[]

  @@map("restaurants")
}

model RestaurantSettings {
  restaurantId         String            @id @map("restaurant_id") @db.Uuid
  gstRegistration      GstRegistration   @default(REGULAR) @map("gst_registration")
  pricesIncludeTax     Boolean           @default(false) @map("prices_include_tax")
  currency             String            @default("INR") @db.VarChar(3)
  timezone             String            @default("Asia/Kolkata")
  roundOffMode         RoundOffMode      @default(NEAREST_RUPEE) @map("round_off_mode")
  serviceChargeEnabled Boolean           @default(false) @map("service_charge_enabled")
  serviceChargeBps     Int               @default(0) @map("service_charge_bps")
  dayCutoffMinutes     Int               @default(0) @map("day_cutoff_minutes") // minutes after midnight when the business day starts
  orderNumberReset     OrderNumberReset  @default(DAILY) @map("order_number_reset")
  orderRenumberMode    OrderRenumberMode @default(AUTO) @map("order_renumber_mode")
  orderNumberEpoch     Int               @default(0) @map("order_number_epoch") // raised when the owner restarts order numbers from 1
  discountCapBps       Int               @default(1000) @map("discount_cap_bps") // max discount without the discount.above_cap permission
  autoPrintKot         Boolean           @default(true) @map("auto_print_kot") // print kitchen tickets when KOT is pressed; false = kitchen display only
  autoPrintReceipt     Boolean           @default(true) @map("auto_print_receipt") // print the bill as soon as it is fully paid
  registerRequired     Boolean           @default(false) @map("register_required") // cash is taken only with the cashier's register open
  defaultTaxGroupId    String?           @map("default_tax_group_id") @db.Uuid
  invoiceFooter        String?           @map("invoice_footer")
  upiVpa               String?           @map("upi_vpa")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  key          String
  name         String
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]

  @@unique([restaurantId, key])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  group       String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  restaurantId     String    @map("restaurant_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  name             String
  email            String    @unique
  phone            String?
  passwordHash     String    @map("password_hash")
  pinHash          String?   @map("pin_hash")
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  // Null only for someone who signed up and has not yet opened the link sent to their email.
  emailVerifiedAt  DateTime? @default(now()) @map("email_verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  restaurant          Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role                Role                     @relation(fields: [roleId], references: [id])
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]
  ordersCreated       Order[]                  @relation("OrderCreatedBy")
  registers           CashRegisterSession[]    @relation("RegisterUser")
  registersClosed     CashRegisterSession[]    @relation("RegisterClosedBy")
  auditLogs           AuditLog[]
  reportShares        ReportShare[]

  @@index([restaurantId])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  terminalId       String?   @map("terminal_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid // all rotations of one login share a family
  refreshTokenHash String    @unique @map("refresh_token_hash")
  client           String    @default("web") @db.VarChar(8) // which front-end app holds this session
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  rotatedAt        DateTime? @map("rotated_at")
  lockedAt         DateTime? @map("locked_at") // terminal locked: only a PIN sign-in is accepted
  createdAt        DateTime  @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  terminal Terminal? @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// The link emailed to someone who signed up, proving the address is theirs.
model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ───────────────────── Platform (the vendor) ─────────────────────

/// Someone at the company that runs the service. Not a restaurant user: they sign in to the admin app only.
model PlatformAdmin {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  email            String    @unique
  passwordHash     String    @map("password_hash")
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sessions PlatformSession[]

  @@map("platform_admins")
}

model PlatformSession {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_sessions")
}

/// A till staff choose at a counter, or the hidden till that numbers one device's offline bills.
enum TerminalKind {
  COUNTER
  OFFLINE
}

model Terminal {
  id           String       @id @default(uuid()) @db.Uuid
  restaurantId String       @map("restaurant_id") @db.Uuid
  code         String       @db.VarChar(4) // short prefix used in invoice and order series, e.g. "A1"
  name         String
  /// OFFLINE: belongs to one device (PosDevice), never listed, never signed in to, and its series are never renumbered.
  kind         TerminalKind @default(COUNTER)
  isActive     Boolean      @default(true) @map("is_active")
  lastSeenAt   DateTime?    @map("last_seen_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  restaurant     Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessions       Session[]
  numberSeries   NumberSeries[]
  orders         Order[]
  invoices       Invoice[]
  registers      CashRegisterSession[]
  syncOperations SyncOperation[]
  offlineDevice  PosDevice?            @relation("DeviceOfflineTerminal")
  homeDevices    PosDevice[]           @relation("DeviceHomeTerminal")

  @@unique([restaurantId, code])
  @@map("terminals")
}

/// A browser or phone the POS runs on. Each has a hidden OFFLINE till of its own, so the bills it makes while the
/// internet is down are numbered in a series no other device uses.
model PosDevice {
  id                String    @id @default(uuid()) @db.Uuid
  restaurantId      String    @map("restaurant_id") @db.Uuid
  /// Chosen by the device and kept in its storage; unique within the restaurant.
  deviceKey         String    @map("device_key") @db.Uuid
  offlineTerminalId String    @unique @map("offline_terminal_id") @db.Uuid
  /// The counter till the device was last signed in on.
  homeTerminalId    String?   @map("home_terminal_id") @db.Uuid
  label             String?   @db.VarChar(200)
  /// Operations the device reported as not yet uploaded, at its last contact.
  pendingCount      Int       @default(0) @map("pending_count")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  lastSyncAt        DateTime? @map("last_sync_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  offlineTerminal Terminal        @relation("DeviceOfflineTerminal", fields: [offlineTerminalId], references: [id], onDelete: Restrict)
  homeTerminal    Terminal?       @relation("DeviceHomeTerminal", fields: [homeTerminalId], references: [id], onDelete: SetNull)
  operations      SyncOperation[]

  @@unique([restaurantId, deviceKey])
  @@map("pos_devices")
}

/// One gapless counter per terminal, document type and financial year.
model NumberSeries {
  id            String     @id @default(uuid()) @db.Uuid
  restaurantId  String     @map("restaurant_id") @db.Uuid
  terminalId    String     @map("terminal_id") @db.Uuid
  type          SeriesType
  financialYear String     @map("financial_year") @db.VarChar(4) // "2627" = FY 2026-27
  prefix        String     @db.VarChar(8)
  nextNumber    Int        @default(1) @map("next_number")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  terminal   Terminal   @relation(fields: [terminalId], references: [id])
  invoices   Invoice[]
  refunds    Refund[]

  @@unique([terminalId, type, financialYear])
  @@map("number_series")
}

// ───────────────────────── Tax and menu ─────────────────────────

model TaxGroup {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  components TaxComponent[]
  products   Product[]

  @@unique([restaurantId, name])
  @@map("tax_groups")
}

/// CGST and SGST apply to intra-state supplies, IGST to inter-state; CESS to both.
model TaxComponent {
  id         String           @id @default(uuid()) @db.Uuid
  taxGroupId String           @map("tax_group_id") @db.Uuid
  type       TaxComponentType
  name       String
  rateBps    Int              @map("rate_bps")

  taxGroup TaxGroup @relation(fields: [taxGroupId], references: [id], onDelete: Cascade)

  @@unique([taxGroupId, type])
  @@map("tax_components")
}

model KitchenStation {
  id                String   @id @default(uuid()) @db.Uuid
  restaurantId      String   @map("restaurant_id") @db.Uuid
  name              String
  sortOrder         Int      @default(0) @map("sort_order")
  printerId         String?  @map("printer_id") @db.Uuid
  fallbackPrinterId String?  @map("fallback_printer_id") @db.Uuid
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  printer         Printer?   @relation("StationPrinter", fields: [printerId], references: [id], onDelete: SetNull)
  fallbackPrinter Printer?   @relation("StationFallbackPrinter", fields: [fallbackPrinterId], references: [id], onDelete: SetNull)
  products        Product[]
  kots            Kot[]

  @@unique([restaurantId, name])
  @@map("kitchen_stations")
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  name         String
  color        String?
  sortOrder    Int       @default(0) @map("sort_order")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([restaurantId, sortOrder])
  @@map("categories")
}

model Product {
  id               String    @id @default(uuid()) @db.Uuid
  restaurantId     String    @map("restaurant_id") @db.Uuid
  categoryId       String    @map("category_id") @db.Uuid
  taxGroupId       String?   @map("tax_group_id") @db.Uuid
  stationId        String?   @map("station_id") @db.Uuid // null = the first active kitchen station
  sendToKitchen    Boolean   @default(true) @map("send_to_kitchen") // false = never on a kitchen ticket (bottled water)
  name             String
  shortCode        String?   @map("short_code") @db.VarChar(8)
  description      String?
  imageUrl         String?   @map("image_url")
  foodType         FoodType  @default(VEG) @map("food_type")
  basePricePaise   Int       @map("base_price_paise")
  priceIncludesTax Boolean?  @map("price_includes_tax") // null = follow restaurant setting
  hsnSac           String?   @map("hsn_sac") @db.VarChar(8)
  isAvailable      Boolean   @default(true) @map("is_available")
  isActive         Boolean   @default(true) @map("is_active")
  isFavourite      Boolean   @default(false) @map("is_favourite")
  sortOrder        Int       @default(0) @map("sort_order")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       Category               @relation(fields: [categoryId], references: [id])
  taxGroup       TaxGroup?              @relation(fields: [taxGroupId], references: [id])
  station        KitchenStation?        @relation(fields: [stationId], references: [id], onDelete: SetNull)
  variants       Variant[]
  modifierGroups ProductModifierGroup[]
  orderItems     OrderItem[]

  @@unique([restaurantId, shortCode])
  @@index([restaurantId, categoryId, sortOrder])
  @@index([restaurantId, updatedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

model Variant {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  name        String
  pricePaise  Int       @map("price_paise")
  isDefault   Boolean   @default(false) @map("is_default")
  isAvailable Boolean   @default(true) @map("is_available")
  sortOrder   Int       @default(0) @map("sort_order")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("variants")
}

model ModifierGroup {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  name         String
  minSelect    Int       @default(0) @map("min_select")
  maxSelect    Int       @default(1) @map("max_select")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifiers  Modifier[]
  products   ProductModifierGroup[]

  @@index([restaurantId])
  @@map("modifier_groups")
}

model Modifier {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  name        String
  pricePaise  Int       @default(0) @map("price_paise")
  isAvailable Boolean   @default(true) @map("is_available")
  sortOrder   Int       @default(0) @map("sort_order")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  group      ModifierGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItems OrderItemModifier[]

  @@index([groupId])
  @@map("modifiers")
}

model ProductModifierGroup {
  productId       String @map("product_id") @db.Uuid
  modifierGroupId String @map("modifier_group_id") @db.Uuid
  sortOrder       Int    @default(0) @map("sort_order")

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

// ───────────────────────── Floor ─────────────────────────

model Area {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     DiningTable[]

  @@unique([restaurantId, name])
  @@map("areas")
}

model DiningTable {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  areaId       String      @map("area_id") @db.Uuid
  name         String
  seats        Int         @default(4)
  status       TableStatus @default(FREE)
  shape        TableShape  @default(SQUARE)
  posX         Int         @default(0) @map("pos_x")
  posY         Int         @default(0) @map("pos_y")
  width        Int         @default(96)
  height       Int         @default(96)
  mergedIntoId String?     @map("merged_into_id") @db.Uuid
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  area         Area          @relation(fields: [areaId], references: [id])
  mergedInto   DiningTable?  @relation("TableMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedTables DiningTable[] @relation("TableMerge")
  orders       Order[]

  @@unique([restaurantId, areaId, name])
  @@map("dining_tables")
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String?
  phone        String // the 10-digit mobile number: it is what identifies a customer
  stateCode    String?  @map("state_code") @db.VarChar(2)
  address      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([restaurantId, phone])
  @@map("customers")
}

// ───────────────────────── Orders ─────────────────────────

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  restaurantId       String      @map("restaurant_id") @db.Uuid
  terminalId         String?     @map("terminal_id") @db.Uuid
  series             String      @db.VarChar(4) // terminal code the order number belongs to
  numberPeriod       String      @map("number_period") @db.VarChar(20) // business date, financial year, or "ALL" per order_number_reset, plus the restart count
  orderNumber        Int         @map("order_number") // display number; renumbered when an unbilled order is deleted
  businessDate       DateTime    @map("business_date") @db.Date
  type               OrderType
  status             OrderStatus @default(OPEN)
  tableId            String?     @map("table_id") @db.Uuid
  customerId         String?     @map("customer_id") @db.Uuid
  createdById        String      @map("created_by_id") @db.Uuid
  guests             Int         @default(1)
  tokenNumber        Int?        @map("token_number")
  notes              String?
  deliveryAddress    String?     @map("delivery_address")
  subtotalPaise      Int         @default(0) @map("subtotal_paise")
  discountPaise      Int         @default(0) @map("discount_paise")
  taxPaise           Int         @default(0) @map("tax_paise")
  serviceChargePaise Int         @default(0) @map("service_charge_paise")
  roundOffPaise      Int         @default(0) @map("round_off_paise")
  totalPaise         Int         @default(0) @map("total_paise")
  heldAt             DateTime?   @map("held_at")
  cancelledAt        DateTime?   @map("cancelled_at")
  cancelledById      String?     @map("cancelled_by_id") @db.Uuid
  cancelReason       String?     @map("cancel_reason")
  mergedIntoId       String?     @map("merged_into_id") @db.Uuid
  version            Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  terminal     Terminal?    @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  table        DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("OrderCreatedBy", fields: [createdById], references: [id])
  mergedInto   Order?       @relation("OrderMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedOrders Order[]      @relation("OrderMerge")
  items        OrderItem[]
  discounts    Discount[]
  kots         Kot[]
  invoices     Invoice[]

  @@unique([restaurantId, series, numberPeriod, orderNumber])
  @@index([restaurantId, businessDate])
  @@index([restaurantId, status])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  productId        String          @map("product_id") @db.Uuid
  variantId        String?         @map("variant_id") @db.Uuid
  stationId        String?         @map("station_id") @db.Uuid
  // Snapshots taken when the item is added, so later menu edits do not change open orders.
  name             String
  variantName      String?         @map("variant_name")
  hsnSac           String?         @map("hsn_sac") @db.VarChar(8)
  taxGroupId       String?         @map("tax_group_id") @db.Uuid
  priceIncludesTax Boolean         @default(false) @map("price_includes_tax")
  quantity         Int
  kotQuantity      Int             @default(0) @map("kot_quantity") // quantity already sent to the kitchen
  unitPricePaise   Int             @map("unit_price_paise") // base or variant price plus modifiers
  isComplimentary  Boolean         @default(false) @map("is_complimentary")
  notes            String?
  status           OrderItemStatus @default(ACTIVE)
  cancelReason     String?         @map("cancel_reason")
  grossPaise       Int             @default(0) @map("gross_paise")
  discountPaise    Int             @default(0) @map("discount_paise")
  taxablePaise     Int             @default(0) @map("taxable_paise")
  taxPaise         Int             @default(0) @map("tax_paise")
  totalPaise       Int             @default(0) @map("total_paise")
  sortOrder        Int             @default(0) @map("sort_order")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product             @relation(fields: [productId], references: [id])
  variant      Variant?            @relation(fields: [variantId], references: [id], onDelete: SetNull)
  modifiers    OrderItemModifier[]
  discounts    Discount[]
  kotItems     KotItem[]
  invoiceItems InvoiceItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id          String @id @default(uuid()) @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  modifierId  String @map("modifier_id") @db.Uuid
  name        String
  pricePaise  Int    @map("price_paise")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

/// A discount on a whole order (order_item_id null) or on one line.
model Discount {
  id           String       @id @default(uuid()) @db.Uuid
  restaurantId String       @map("restaurant_id") @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  orderItemId  String?      @map("order_item_id") @db.Uuid
  type         DiscountType
  value        Int // basis points for PERCENT, paise for AMOUNT
  amountPaise  Int          @default(0) @map("amount_paise")
  reason       String?
  appliedById  String       @map("applied_by_id") @db.Uuid
  approvedById String?      @map("approved_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem  OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([restaurantId, createdAt])
  @@map("discounts")
}

// ───────────────────────── Kitchen ─────────────────────────

model Kot {
  id            String    @id @default(uuid()) @db.Uuid
  restaurantId  String    @map("restaurant_id") @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  stationId     String?   @map("station_id") @db.Uuid
  kotNumber     Int       @map("kot_number")
  businessDate  DateTime  @map("business_date") @db.Date
  type          KotType   @default(NEW)
  status        KotStatus @default(PENDING)
  printCount    Int       @default(0) @map("print_count")
  /// The number printed on a ticket made offline. Ticket numbers are the restaurant's, so the server gave it its own.
  offlineNumber String?   @map("offline_number") @db.VarChar(20)
  notes         String?
  createdById   String    @map("created_by_id") @db.Uuid
  preparingAt   DateTime? @map("preparing_at")
  readyAt       DateTime? @map("ready_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station    KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  items      KotItem[]

  @@unique([restaurantId, businessDate, kotNumber])
  @@index([restaurantId, status])
  @@index([orderId])
  @@map("kots")
}

model KotItem {
  id                String  @id @default(uuid()) @db.Uuid
  kotId             String  @map("kot_id") @db.Uuid
  orderItemId       String? @map("order_item_id") @db.Uuid
  name              String
  quantity          Int
  /// How many of these were later taken back by a cancellation ticket; the kitchen no longer makes them.
  cancelledQuantity Int     @default(0) @map("cancelled_quantity")
  notes             String?

  kot       Kot        @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([kotId])
  @@map("kot_items")
}

// ───────────────────────── Invoices ─────────────────────────

/// The legal document. Financial columns are immutable once issued (enforced by a trigger).
model Invoice {
  id                 String               @id @default(uuid()) @db.Uuid
  restaurantId       String               @map("restaurant_id") @db.Uuid
  orderId            String               @map("order_id") @db.Uuid
  terminalId         String?              @map("terminal_id") @db.Uuid
  seriesId           String               @map("series_id") @db.Uuid
  number             Int
  invoiceNumber      String               @map("invoice_number") @db.VarChar(16)
  docType            InvoiceDocType       @default(TAX_INVOICE) @map("doc_type")
  status             InvoiceStatus        @default(ISSUED)
  paymentStatus      InvoicePaymentStatus @default(UNPAID) @map("payment_status")
  businessDate       DateTime             @map("business_date") @db.Date
  issuedAt           DateTime             @default(now()) @map("issued_at")
  sellerSnapshot     Json                 @map("seller_snapshot")
  customerName       String?              @map("customer_name")
  customerPhone      String?              @map("customer_phone")
  customerGstin      String?              @map("customer_gstin")
  customerAddress    String?              @map("customer_address")
  placeOfSupply      String               @map("place_of_supply") @db.VarChar(2)
  isInterState       Boolean              @default(false) @map("is_inter_state")
  grossPaise         Int                  @map("gross_paise")
  discountPaise      Int                  @default(0) @map("discount_paise")
  taxablePaise       Int                  @map("taxable_paise")
  cgstPaise          Int                  @default(0) @map("cgst_paise")
  sgstPaise          Int                  @default(0) @map("sgst_paise")
  igstPaise          Int                  @default(0) @map("igst_paise")
  cessPaise          Int                  @default(0) @map("cess_paise")
  serviceChargePaise Int                  @default(0) @map("service_charge_paise")
  roundOffPaise      Int                  @default(0) @map("round_off_paise")
  totalPaise         Int                  @map("total_paise")
  paidPaise          Int                  @default(0) @map("paid_paise")
  refundedPaise      Int                  @default(0) @map("refunded_paise")
  printCount         Int                  @default(0) @map("print_count")
  irn                String? // reserved for e-invoicing
  createdById        String               @map("created_by_id") @db.Uuid
  cancelledAt        DateTime?            @map("cancelled_at")
  cancelledById      String?              @map("cancelled_by_id") @db.Uuid
  cancelReason       String?              @map("cancel_reason")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  terminal   Terminal?     @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  series     NumberSeries  @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  items      InvoiceItem[]
  taxes      InvoiceTax[]
  payments   Payment[]
  refunds    Refund[]

  @@unique([seriesId, number])
  @@unique([restaurantId, invoiceNumber])
  @@index([restaurantId, businessDate])
  @@index([orderId])
  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  orderItemId    String? @map("order_item_id") @db.Uuid
  name           String
  hsnSac         String? @map("hsn_sac") @db.VarChar(8)
  quantity       Int
  unitPricePaise Int     @map("unit_price_paise")
  grossPaise     Int     @map("gross_paise")
  discountPaise  Int     @default(0) @map("discount_paise")
  taxablePaise   Int     @map("taxable_paise")
  taxRateBps     Int     @default(0) @map("tax_rate_bps")
  cgstPaise      Int     @default(0) @map("cgst_paise")
  sgstPaise      Int     @default(0) @map("sgst_paise")
  igstPaise      Int     @default(0) @map("igst_paise")
  cessPaise      Int     @default(0) @map("cess_paise")
  totalPaise     Int     @map("total_paise")
  sortOrder      Int     @default(0) @map("sort_order")

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  orderItem   OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  refundItems RefundItem[]

  @@index([invoiceId])
  @@map("invoice_items")
}

/// Tax summary per component and rate, as printed on the invoice and used by GST reports.
model InvoiceTax {
  id           String           @id @default(uuid()) @db.Uuid
  invoiceId    String           @map("invoice_id") @db.Uuid
  type         TaxComponentType
  name         String
  rateBps      Int              @map("rate_bps")
  taxablePaise Int              @map("taxable_paise")
  amountPaise  Int              @map("amount_paise")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_taxes")
}

// ───────────────────────── Payments ─────────────────────────

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  restaurantId      String        @map("restaurant_id") @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  registerSessionId String?       @map("register_session_id") @db.Uuid
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amountPaise       Int           @map("amount_paise")
  tenderedPaise     Int?          @map("tendered_paise")
  changePaise       Int?          @map("change_paise")
  refundedPaise     Int           @default(0) @map("refunded_paise")
  provider          String        @default("manual")
  providerRef       String?       @map("provider_ref")
  reference         String? // cashier-entered UPI or card reference
  failureReason     String?       @map("failure_reason")
  idempotencyKey    String        @unique @map("idempotency_key")
  businessDate      DateTime      @map("business_date") @db.Date
  receivedById      String        @map("received_by_id") @db.Uuid
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  invoice         Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  registerSession CashRegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)
  attempts        PaymentAttempt[]
  refunds         Refund[]

  @@index([restaurantId, businessDate])
  @@index([invoiceId])
  @@index([registerSessionId])
  @@map("payments")
}

model PaymentAttempt {
  id                String        @id @default(uuid()) @db.Uuid
  paymentId         String        @map("payment_id") @db.Uuid
  provider          String
  status            PaymentStatus
  providerOrderId   String?       @map("provider_order_id")
  providerPaymentId String?       @map("provider_payment_id")
  errorCode         String?       @map("error_code")
  errorMessage      String?       @map("error_message")
  rawPayload        Json?         @map("raw_payload")
  createdAt         DateTime      @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([provider, providerOrderId])
  @@map("payment_attempts")
}

model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  payload     Json
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

/// A refund is a credit note against an invoice, with its own number series.
model Refund {
  id                String        @id @default(uuid()) @db.Uuid
  restaurantId      String        @map("restaurant_id") @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  paymentId         String?       @map("payment_id") @db.Uuid
  registerSessionId String?       @map("register_session_id") @db.Uuid
  seriesId          String        @map("series_id") @db.Uuid
  number            Int
  creditNoteNumber  String        @map("credit_note_number") @db.VarChar(16)
  method            PaymentMethod
  status            RefundStatus  @default(SUCCESS)
  amountPaise       Int           @map("amount_paise")
  taxablePaise      Int           @default(0) @map("taxable_paise")
  cgstPaise         Int           @default(0) @map("cgst_paise")
  sgstPaise         Int           @default(0) @map("sgst_paise")
  igstPaise         Int           @default(0) @map("igst_paise")
  cessPaise         Int           @default(0) @map("cess_paise")
  reason            String
  providerRef       String?       @map("provider_ref")
  idempotencyKey    String        @unique @map("idempotency_key")
  businessDate      DateTime      @map("business_date") @db.Date
  createdById       String        @map("created_by_id") @db.Uuid
  approvedById      String?       @map("approved_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")

  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  invoice         Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment         Payment?             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  registerSession CashRegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)
  series          NumberSeries         @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  items           RefundItem[]

  @@unique([seriesId, number])
  @@unique([restaurantId, creditNoteNumber])
  @@index([restaurantId, businessDate])
  @@index([invoiceId])
  @@index([registerSessionId])
  @@map("refunds")
}

model RefundItem {
  id            String @id @default(uuid()) @db.Uuid
  refundId      String @map("refund_id") @db.Uuid
  invoiceItemId String @map("invoice_item_id") @db.Uuid
  quantity      Int
  amountPaise   Int    @map("amount_paise")

  refund      Refund      @relation(fields: [refundId], references: [id], onDelete: Restrict)
  invoiceItem InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)

  @@index([refundId])
  @@map("refund_items")
}

// ───────────────────────── Cash register ─────────────────────────

model CashRegisterSession {
  id                String         @id @default(uuid()) @db.Uuid
  restaurantId      String         @map("restaurant_id") @db.Uuid
  terminalId        String?        @map("terminal_id") @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  status            RegisterStatus @default(OPEN)
  businessDate      DateTime       @map("business_date") @db.Date
  openingCashPaise  Int            @map("opening_cash_paise")
  expectedCashPaise Int?           @map("expected_cash_paise")
  countedCashPaise  Int?           @map("counted_cash_paise")
  variancePaise     Int?           @map("variance_paise")
  denominations     Json?
  closingNotes      String?        @map("closing_notes")
  closedById        String?        @map("closed_by_id") @db.Uuid
  openedAt          DateTime       @default(now()) @map("opened_at")
  closedAt          DateTime?      @map("closed_at")

  restaurant   Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  terminal     Terminal?                 @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  user         User                      @relation("RegisterUser", fields: [userId], references: [id])
  closedBy     User?                     @relation("RegisterClosedBy", fields: [closedById], references: [id])
  transactions CashRegisterTransaction[]
  payments     Payment[]
  refunds      Refund[]

  @@index([restaurantId, businessDate])
  @@index([userId, status])
  @@map("cash_register_sessions")
}

model CashRegisterTransaction {
  id          String              @id @default(uuid()) @db.Uuid
  sessionId   String              @map("session_id") @db.Uuid
  type        CashTransactionType
  amountPaise Int                 @map("amount_paise") // always positive; the type gives the direction
  reason      String?
  paymentId   String?             @map("payment_id") @db.Uuid
  refundId    String?             @map("refund_id") @db.Uuid
  createdById String              @map("created_by_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")

  session CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@map("cash_register_transactions")
}

// ───────────────────────── Printing ─────────────────────────

model Printer {
  id           String            @id @default(uuid()) @db.Uuid
  restaurantId String            @map("restaurant_id") @db.Uuid
  name         String
  role         PrinterRole
  connection   PrinterConnection
  paperWidth   PaperWidth        @default(MM80) @map("paper_width")
  host         String? // network printers
  port         Int?
  devicePath   String?           @map("device_path") // USB or Bluetooth device identifier on the bridge machine
  isDefault    Boolean           @default(false) @map("is_default")
  isActive     Boolean           @default(true) @map("is_active")
  lastStatus   String?           @map("last_status")
  lastError    String?           @map("last_error")
  lastSeenAt   DateTime?         @map("last_seen_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  stations         KitchenStation[] @relation("StationPrinter")
  fallbackStations KitchenStation[] @relation("StationFallbackPrinter")
  jobs             PrintJob[]

  @@unique([restaurantId, name])
  @@map("printers")
}

/// How a kind of printout is laid out. One per restaurant and type; the paper width comes from the printer.
model PrintTemplate {
  id           String       @id @default(uuid()) @db.Uuid
  restaurantId String       @map("restaurant_id") @db.Uuid
  type         PrintJobType
  name         String
  config       Json
  isDefault    Boolean      @default(false) @map("is_default")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, type, name])
  @@map("print_templates")
}

model PrintJob {
  id            String         @id @default(uuid()) @db.Uuid
  restaurantId  String         @map("restaurant_id") @db.Uuid
  printerId     String?        @map("printer_id") @db.Uuid
  type          PrintJobType
  status        PrintJobStatus @default(QUEUED)
  refType       String?        @map("ref_type")
  refId         String?        @map("ref_id") @db.Uuid
  title         String         @default("") // what the queue shows, e.g. "Bill A1/2627/000007"
  payload       Json
  isReprint     Boolean        @default(false) @map("is_reprint")
  attempts      Int            @default(0)
  lastError     String?        @map("last_error")
  fallbackTried Boolean        @default(false) @map("fallback_tried")
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at")
  claimedAt     DateTime?      @map("claimed_at")
  requestedById String?        @map("requested_by_id") @db.Uuid
  printedAt     DateTime?      @map("printed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  printer    Printer?   @relation(fields: [printerId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@index([refType, refId])
  @@map("print_jobs")
}

/// The print bridge installed at an outlet. It signs in with a token shown once when the bridge is added.
model PrintBridge {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  name         String
  tokenHash    String    @unique @map("token_hash")
  version      String?
  lastSeenAt   DateTime? @map("last_seen_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
  @@map("print_bridges")
}

// ───────────────────────── Reconciliation ─────────────────────────

/// What the bank or payment provider actually paid out for one day and method, entered by the manager.
model PaymentReconciliation {
  id             String        @id @default(uuid()) @db.Uuid
  restaurantId   String        @map("restaurant_id") @db.Uuid
  businessDate   DateTime      @map("business_date") @db.Date
  method         PaymentMethod
  recordedPaise  Int           @map("recorded_paise") // what the system showed when this was entered
  settledPaise   Int           @map("settled_paise")
  note           String?
  reconciledById String        @map("reconciled_by_id") @db.Uuid
  reconciledAt   DateTime      @default(now()) @map("reconciled_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, businessDate, method])
  @@map("payment_reconciliations")
}

// ───────────────────────── Reports ─────────────────────────

/// One report made visible to one user who does not have access to all reports.
model ReportShare {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  reportType   String   @map("report_type") @db.VarChar(40)
  userId       String   @map("user_id") @db.Uuid
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, reportType, userId])
  @@index([userId])
  @@map("report_shares")
}

// ───────────────────── Audit, sync, idempotency ─────────────────────

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  terminalId   String?  @map("terminal_id") @db.Uuid
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  before       Json?
  after        Json?
  reason       String?
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// One row per offline operation received from a terminal; the id is generated on the client,
/// so a retried push is recognised and never applied twice.
/// One piece of work a device did while offline (an order, a kitchen ticket, a bill or a payment), uploaded later and
/// applied exactly once: its id is chosen by the device. Kept with what came of it, and with anything the owner should
/// check (`flags`) until someone marks it checked.
model SyncOperation {
  id              String              @id @db.Uuid
  restaurantId    String              @map("restaurant_id") @db.Uuid
  /// The device's hidden offline till.
  terminalId      String              @map("terminal_id") @db.Uuid
  deviceId        String?             @map("device_id") @db.Uuid
  /// Who did the work on the device, and who was signed in when it was uploaded.
  userId          String?             @map("user_id") @db.Uuid
  uploadedById    String?             @map("uploaded_by_id") @db.Uuid
  type            String
  /// The order, ticket, bill or payment the operation is about, and the order it belongs to.
  entityId        String?             @map("entity_id") @db.Uuid
  orderId         String?             @map("order_id") @db.Uuid
  payload         Json
  status          SyncOperationStatus
  error           String?
  result          Json?
  /// What the owner should check: [{ code, message }]. Null when there is nothing.
  flags           Json?
  reviewedAt      DateTime?           @map("reviewed_at")
  reviewedById    String?             @map("reviewed_by_id") @db.Uuid
  clientCreatedAt DateTime            @map("client_created_at")
  appliedAt       DateTime            @default(now()) @map("applied_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  terminal   Terminal   @relation(fields: [terminalId], references: [id])
  device     PosDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([restaurantId, terminalId, appliedAt])
  @@index([restaurantId, entityId])
  @@index([restaurantId, reviewedAt])
  @@map("sync_operations")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  restaurantId   String   @map("restaurant_id") @db.Uuid
  key            String
  route          String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, key])
  @@map("idempotency_records")
}
