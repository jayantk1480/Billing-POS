{
  "name": "@pos/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pos/types": "workspace:*",
    "@pos/validation": "workspace:*",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@pos/config": "workspace:*",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
